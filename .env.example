# Next.js 서버 전용 설정입니다. 필요하면 .env.local에 복사합니다.
# loopback HTTP 주소만 허용됩니다. 브라우저용 NEXT_PUBLIC_* 변수로 만들지 않습니다.
FACTLENS_BACKEND_URL=http://127.0.0.1:8010

# OpenAI 키는 Next.js가 아닌 backend/.env에 OPENAI_API_KEY로 설정합니다.
# 실제 키를 이 예제 파일, 채팅 또는 Git에 넣지 않습니다.
# Python 서비스 모델: gpt-5.6-luna / reasoning.effort: max
# 실제 OpenAI Responses 및 검색 요청에는 비용이 발생할 수 있습니다.
